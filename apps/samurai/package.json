{
  "name": "@samurai/samurai",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "samurai",
     "targets": {
      "build": {
        "executor": "@nx/next:build",
        "options": {
          "outputPath": "dist/apps/samurai"
        }
      },
      "serve": {
        "executor": "@nx/next:server",
        "options": {
          "buildTarget": "samurai:build",
          "dev": true
        }
      }
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "~15.2.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
